{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.codespar/mcp-openpay",
  "description": "Safe-by-default MCP server for Openpay payments, subscriptions, webhooks, and payouts",
  "repository": {
    "url": "https://github.com/codespar/mcp-dev-latam",
    "source": "github",
    "subfolder": "packages/payments/openpay"
  },
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@codespar/mcp-openpay",
      "version": "0.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OPENPAY_MERCHANT_ID",
          "description": "Openpay merchant identifier",
          "isRequired": true,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "OPENPAY_PRIVATE_KEY",
          "description": "Openpay private API key",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "OPENPAY_ENV",
          "description": "Provider environment: sandbox (default) or production",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "OPENPAY_ENABLE_PRODUCTION",
          "description": "Set to true to permit production endpoints",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "OPENPAY_ALLOW_MUTATIONS",
          "description": "Set to true to enable state-changing and money-moving tools",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "OPENPAY_ALLOW_PAYOUTS",
          "description": "Set to true, together with OPENPAY_ALLOW_MUTATIONS, to enable payouts",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "OPENPAY_REQUEST_TIMEOUT_MS",
          "description": "Provider request timeout from 1000 through 30000 milliseconds",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ],
  "provider": {
    "homepage": "https://www.openpay.mx",
    "logoUrl": "https://logo.clearbit.com/openpay.mx",
    "logoFallback": "https://www.google.com/s2/favicons?domain=openpay.mx&sz=128",
    "docsUrl": "https://documents.openpay.mx/docs/api/index.html",
    "sandbox": {
      "available": true
    }
  }
}
